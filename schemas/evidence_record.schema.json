{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finproof.local/schemas/evidence_record.schema.json",
  "title": "FinProof Evidence",
  "$defs": {
    "value": {"type": ["string", "number", "boolean", "null"]},
    "quality_status": {
      "enum": [
        "valid",
        "missing_blank",
        "missing_literal_null",
        "sentinel_zero",
        "sentinel_max_date",
        "recorded_zero",
        "recorded_zero_unverified",
        "invalid_format",
        "out_of_domain",
        "constant_metric",
        "stale",
        "mixed_source_values",
        "malformed_source_row"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_table",
        "source_file",
        "source_sheet",
        "source_row_number",
        "source_column_name",
        "source_column_number",
        "source_column_letter",
        "source_checksum",
        "source_snapshot_date",
        "source_applicable_date"
      ],
      "properties": {
        "source_table": {"type": "string", "minLength": 1},
        "source_file": {"type": "string", "minLength": 1},
        "source_sheet": {"type": "string", "minLength": 1},
        "source_row_number": {"type": "integer", "minimum": 1},
        "source_column_name": {"type": "string", "minLength": 1},
        "source_column_number": {"type": "integer", "minimum": 1},
        "source_column_letter": {"type": "string", "pattern": "^[A-Z]+$"},
        "source_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_snapshot_date": {"type": "string", "format": "date"},
        "source_applicable_date": {
          "anyOf": [{"type": "null"}, {"type": "string", "format": "date"}]
        }
      }
    },
    "normalized": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_value",
        "normalized_value",
        "quality_status",
        "rule_id",
        "rule_version",
        "source"
      ],
      "properties": {
        "raw_value": {"type": "string"},
        "normalized_value": {"$ref": "#/$defs/value"},
        "quality_status": {"$ref": "#/$defs/quality_status"},
        "rule_id": {"type": "string", "minLength": 1},
        "rule_version": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "quality_status", "rule_id", "rule_version", "as_of_date", "inputs"],
      "properties": {
        "value": {"$ref": "#/$defs/value"},
        "quality_status": {"$ref": "#/$defs/quality_status"},
        "rule_id": {"type": "string", "minLength": 1},
        "rule_version": {"type": "string", "minLength": 1},
        "as_of_date": {"type": "string", "format": "date"},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/source"}}
      }
    },
    "direct_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "product_type", "product_id", "field_id", "value"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "product_type": {"enum": ["domestic_bond", "domestic_etf", "domestic_etn", "overseas_etf", "overseas_etn", "public_fund"]},
        "product_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 300},
        "field_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "value": {"$ref": "#/$defs/normalized"}
      }
    },
    "derived_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "product_type", "product_id", "field_id", "value"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "product_type": {"enum": ["domestic_bond", "domestic_etf", "domestic_etn", "overseas_etf", "overseas_etn", "public_fund"]},
        "product_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 300},
        "field_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "value": {"$ref": "#/$defs/derived"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_id",
        "kind",
        "included_count",
        "excluded_count",
        "evidence_ids",
        "policy_versions",
        "validated_plan_sha256",
        "version_bundle_sha256",
        "artifact_manifest_hash"
      ],
      "properties": {
        "summary_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "kind": {"enum": ["count", "exclusion", "rank", "tie", "partition", "aggregate"]},
        "included_count": {"type": "integer", "minimum": 0},
        "excluded_count": {"type": "integer", "minimum": 0},
        "evidence_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "policy_versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "validated_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "version_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifact_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        ,"product_types": {
          "type": "array",
          "maxItems": 6,
          "items": {"enum": ["domestic_bond", "domestic_etf", "domestic_etn", "overseas_etf", "overseas_etn", "public_fund"]}
        },
        "native_result_grains": {
          "type": "array",
          "maxItems": 3,
          "items": {"enum": ["instrument", "listed_product", "fund_item", "fund_attribute", "fund_family_candidate", "product"]}
        },
        "partition_key": {"type": ["string", "null"], "minLength": 1, "maxLength": 300},
        "product_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 300},
        "metric_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 100},
        "rank": {"type": ["integer", "null"], "minimum": 1},
        "tie_count": {"type": ["integer", "null"], "minimum": 1},
        "value": {"$ref": "#/$defs/value"},
        "group_values": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field_id", "value"],
            "properties": {
              "field_id": {"type": "string", "minLength": 1, "maxLength": 100},
              "value": {"$ref": "#/$defs/value"}
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/direct_evidence"},
    {"$ref": "#/$defs/derived_evidence"},
    {"$ref": "#/$defs/summary"}
  ]
}
