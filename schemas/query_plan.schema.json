{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finproof.local/schemas/query_plan.schema.json",
  "title": "FinProof QueryPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "product_types",
    "entities",
    "as_of_date",
    "result_grain",
    "filters",
    "metrics",
    "sort",
    "top_k",
    "top_k_scope",
    "needs_clarification",
    "clarification_reason"
  ],
  "properties": {
    "intent": {
      "enum": [
        "lookup",
        "screen",
        "screen_rank",
        "compare",
        "aggregate",
        "explain",
        "clarify",
        "unsupported"
      ]
    },
    "product_types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "domestic_bond",
          "domestic_etf",
          "domestic_etn",
          "overseas_etf",
          "overseas_etn",
          "public_fund"
        ]
      }
    },
    "entities": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "identifier_type": {
            "enum": [
              "unknown",
              "product_id",
              "market_identifier",
              "isin",
              "ticker",
              "name"
            ]
          }
        }
      }
    },
    "as_of_date": {
      "type": "string",
      "format": "date"
    },
    "result_grain": {
      "enum": [
        "product",
        "instrument",
        "listed_product",
        "fund_item",
        "fund_attribute",
        "fund_family_candidate"
      ]
    },
    "filters": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "operator",
          "value"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "operator": {
            "enum": [
              "eq",
              "ne",
              "gt",
              "gte",
              "lt",
              "lte",
              "in",
              "not_in",
              "between",
              "contains",
              "starts_with",
              "is_missing",
              "is_not_missing"
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "sort": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "direction"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "direction": {
            "enum": [
              "asc",
              "desc"
            ]
          }
        }
      }
    },
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "top_k_scope": {
      "enum": [
        "global",
        "per_product_type"
      ]
    },
    "needs_clarification": {
      "type": "boolean"
    },
    "clarification_reason": {
      "type": "string",
      "maxLength": 1000
    }
  }
}
