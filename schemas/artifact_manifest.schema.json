{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "artifact_contract_version",
    "artifact_set_id",
    "dataset_version",
    "persistence_timestamp",
    "source_inputs",
    "versions",
    "files",
    "database_path",
    "database_sha256",
    "tables",
    "logical_hash"
  ],
  "properties": {
    "manifest_version": {"const": "1.0.0"},
    "artifact_contract_version": {"const": "1.0.0"},
    "artifact_set_id": {"const": "finproof-data-artifacts/v1"},
    "dataset_version": {"const": "2026-08-24", "format": "date"},
    "persistence_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "source_inputs": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/artifactInput"},
            {"properties": {"namespace": {"const": "source_root"}, "path": {"const": "input_manifest.json"}, "kind": {"const": "source_manifest"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/artifactInput"},
            {"properties": {"namespace": {"const": "source_root"}, "path": {"const": "schema_catalog.json"}, "kind": {"const": "source_schema_catalog"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/artifactInput"},
            {"properties": {"namespace": {"const": "repository"}, "path": {"const": "config/artifact_build.yaml"}, "kind": {"const": "artifact_build_config"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/artifactInput"},
            {"properties": {"namespace": {"const": "repository"}, "path": {"const": "config/datasets.yaml"}, "kind": {"const": "dataset_registry"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/artifactInput"},
            {"properties": {"namespace": {"const": "repository"}, "path": {"const": "config/quality_rules.yaml"}, "kind": {"const": "quality_rule_registry"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/artifactInput"},
            {"properties": {"namespace": {"const": "repository"}, "path": {"const": "config/rating_scale.yaml"}, "kind": {"const": "rating_scale_registry"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/artifactInput"},
            {"properties": {"namespace": {"const": "repository"}, "path": {"const": "config/state_rules.yaml"}, "kind": {"const": "state_rule_registry"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/artifactInput"},
            {"properties": {"namespace": {"const": "repository"}, "path": {"const": "schemas/artifact_manifest.schema.json"}, "kind": {"const": "artifact_manifest_schema"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/artifactInput"},
            {"properties": {"namespace": {"const": "repository"}, "path": {"const": "schemas/quality_issue.schema.json"}, "kind": {"const": "quality_issue_schema"}}}
          ]
        }
      ],
      "items": false
    },
    "versions": {"$ref": "#/$defs/artifactVersions"},
    "files": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/artifactFile"}, {"properties": {"path": {"const": "finproof.duckdb"}, "kind": {"const": "duckdb"}}}]},
        {"allOf": [{"$ref": "#/$defs/artifactFile"}, {"properties": {"path": {"const": "parquet/bronze_source_cell.parquet"}, "kind": {"const": "parquet"}}}]},
        {"allOf": [{"$ref": "#/$defs/artifactFile"}, {"properties": {"path": {"const": "parquet/bronze_source_column.parquet"}, "kind": {"const": "parquet"}}}]},
        {"allOf": [{"$ref": "#/$defs/artifactFile"}, {"properties": {"path": {"const": "parquet/bronze_source_row.parquet"}, "kind": {"const": "parquet"}}}]},
        {"allOf": [{"$ref": "#/$defs/artifactFile"}, {"properties": {"path": {"const": "parquet/gold_exact_cross_source_link.parquet"}, "kind": {"const": "parquet"}}}]},
        {"allOf": [{"$ref": "#/$defs/artifactFile"}, {"properties": {"path": {"const": "parquet/gold_exact_cross_source_link_evidence.parquet"}, "kind": {"const": "parquet"}}}]},
        {"allOf": [{"$ref": "#/$defs/artifactFile"}, {"properties": {"path": {"const": "parquet/silver_bond_instrument.parquet"}, "kind": {"const": "parquet"}}}]},
        {"allOf": [{"$ref": "#/$defs/artifactFile"}, {"properties": {"path": {"const": "parquet/silver_bond_sale_lot.parquet"}, "kind": {"const": "parquet"}}}]},
        {"allOf": [{"$ref": "#/$defs/artifactFile"}, {"properties": {"path": {"const": "parquet/silver_domestic_listed_product.parquet"}, "kind": {"const": "parquet"}}}]},
        {"allOf": [{"$ref": "#/$defs/artifactFile"}, {"properties": {"path": {"const": "parquet/silver_fund_item.parquet"}, "kind": {"const": "parquet"}}}]},
        {"allOf": [{"$ref": "#/$defs/artifactFile"}, {"properties": {"path": {"const": "parquet/silver_overseas_listed_product.parquet"}, "kind": {"const": "parquet"}}}]},
        {"allOf": [{"$ref": "#/$defs/artifactFile"}, {"properties": {"path": {"const": "parquet/silver_product_holding.parquet"}, "kind": {"const": "parquet"}}}]},
        {"allOf": [{"$ref": "#/$defs/artifactFile"}, {"properties": {"path": {"const": "parquet/silver_product_holding_coverage.parquet"}, "kind": {"const": "parquet"}}}]},
        {"allOf": [{"$ref": "#/$defs/artifactFile"}, {"properties": {"path": {"const": "parquet/silver_quality_issue.parquet"}, "kind": {"const": "parquet"}}}]},
        {"allOf": [{"$ref": "#/$defs/artifactFile"}, {"properties": {"path": {"const": "reports/quality_summary.json"}, "kind": {"const": "report"}, "report_id": {"const": "quality_summary"}}}]},
        {"allOf": [{"$ref": "#/$defs/artifactFile"}, {"properties": {"path": {"const": "reports/source_audit.json"}, "kind": {"const": "report"}, "report_id": {"const": "source_audit"}}}]}
      ],
      "items": false
    },
    "database_path": {
      "const": "finproof.duckdb",
      "format": "artifact-relative-path"
    },
    "database_sha256": {"$ref": "#/$defs/sha256"},
    "tables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bronze_source_cell",
        "bronze_source_column",
        "bronze_source_row",
        "gold_exact_cross_source_link",
        "gold_exact_cross_source_link_evidence",
        "silver_bond_instrument",
        "silver_bond_sale_lot",
        "silver_domestic_listed_product",
        "silver_fund_item",
        "silver_overseas_listed_product",
        "silver_product_holding",
        "silver_product_holding_coverage",
        "silver_quality_issue"
      ],
      "properties": {
        "bronze_source_cell": {
          "allOf": [{"$ref": "#/$defs/artifactTable"}, {"properties": {"table_name": {"const": "bronze_source_cell"}, "layer": {"const": "bronze"}, "grain": {"const": "source_cell"}, "parquet_path": {"const": "parquet/bronze_source_cell.parquet"}}}]
        },
        "bronze_source_column": {
          "allOf": [{"$ref": "#/$defs/artifactTable"}, {"properties": {"table_name": {"const": "bronze_source_column"}, "layer": {"const": "bronze"}, "grain": {"const": "source_column"}, "parquet_path": {"const": "parquet/bronze_source_column.parquet"}}}]
        },
        "bronze_source_row": {
          "allOf": [{"$ref": "#/$defs/artifactTable"}, {"properties": {"table_name": {"const": "bronze_source_row"}, "layer": {"const": "bronze"}, "grain": {"const": "source_row"}, "parquet_path": {"const": "parquet/bronze_source_row.parquet"}}}]
        },
        "gold_exact_cross_source_link": {
          "allOf": [{"$ref": "#/$defs/artifactTable"}, {"properties": {"table_name": {"const": "gold_exact_cross_source_link"}, "layer": {"const": "gold"}, "grain": {"const": "exact_cross_source_link"}, "parquet_path": {"const": "parquet/gold_exact_cross_source_link.parquet"}}}]
        },
        "gold_exact_cross_source_link_evidence": {
          "allOf": [{"$ref": "#/$defs/artifactTable"}, {"properties": {"table_name": {"const": "gold_exact_cross_source_link_evidence"}, "layer": {"const": "gold"}, "grain": {"const": "exact_cross_source_link_evidence"}, "parquet_path": {"const": "parquet/gold_exact_cross_source_link_evidence.parquet"}}}]
        },
        "silver_bond_instrument": {
          "allOf": [{"$ref": "#/$defs/artifactTable"}, {"properties": {"table_name": {"const": "silver_bond_instrument"}, "layer": {"const": "silver"}, "grain": {"const": "instrument"}, "parquet_path": {"const": "parquet/silver_bond_instrument.parquet"}}}]
        },
        "silver_bond_sale_lot": {
          "allOf": [{"$ref": "#/$defs/artifactTable"}, {"properties": {"table_name": {"const": "silver_bond_sale_lot"}, "layer": {"const": "silver"}, "grain": {"const": "bond_sale_lot"}, "parquet_path": {"const": "parquet/silver_bond_sale_lot.parquet"}}}]
        },
        "silver_domestic_listed_product": {
          "allOf": [{"$ref": "#/$defs/artifactTable"}, {"properties": {"table_name": {"const": "silver_domestic_listed_product"}, "layer": {"const": "silver"}, "grain": {"const": "listed_product"}, "parquet_path": {"const": "parquet/silver_domestic_listed_product.parquet"}}}]
        },
        "silver_fund_item": {
          "allOf": [{"$ref": "#/$defs/artifactTable"}, {"properties": {"table_name": {"const": "silver_fund_item"}, "layer": {"const": "silver"}, "grain": {"const": "fund_item"}, "parquet_path": {"const": "parquet/silver_fund_item.parquet"}}}]
        },
        "silver_overseas_listed_product": {
          "allOf": [{"$ref": "#/$defs/artifactTable"}, {"properties": {"table_name": {"const": "silver_overseas_listed_product"}, "layer": {"const": "silver"}, "grain": {"const": "listed_product"}, "parquet_path": {"const": "parquet/silver_overseas_listed_product.parquet"}}}]
        },
        "silver_product_holding": {
          "allOf": [{"$ref": "#/$defs/artifactTable"}, {"properties": {"table_name": {"const": "silver_product_holding"}, "layer": {"const": "silver"}, "grain": {"const": "product_holding"}, "parquet_path": {"const": "parquet/silver_product_holding.parquet"}}}]
        },
        "silver_product_holding_coverage": {
          "allOf": [{"$ref": "#/$defs/artifactTable"}, {"properties": {"table_name": {"const": "silver_product_holding_coverage"}, "layer": {"const": "silver"}, "grain": {"const": "product_holding_coverage"}, "parquet_path": {"const": "parquet/silver_product_holding_coverage.parquet"}}}]
        },
        "silver_quality_issue": {
          "allOf": [{"$ref": "#/$defs/artifactTable"}, {"properties": {"table_name": {"const": "silver_quality_issue"}, "layer": {"const": "silver"}, "grain": {"const": "quality_issue"}, "parquet_path": {"const": "parquet/silver_quality_issue.parquet"}}}]
        }
      },
      "minProperties": 13,
      "maxProperties": 13
    },
    "logical_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*%)(?!.*\\u0000)[^/]+(?:/[^/]+)*$"
    },
    "artifactInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "path", "kind", "size_bytes", "sha256"],
      "properties": {
        "namespace": {"enum": ["source_root", "repository"]},
        "path": {"$ref": "#/$defs/safePath"},
        "kind": {
          "enum": [
            "source_manifest",
            "source_schema_catalog",
            "artifact_build_config",
            "dataset_registry",
            "quality_rule_registry",
            "rating_scale_registry",
            "state_rule_registry",
            "artifact_manifest_schema",
            "quality_issue_schema"
          ]
        },
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifactVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_version",
        "metric_registry_version",
        "state_rule_version",
        "quality_rule_version",
        "rating_rule_version",
        "answer_policy_version",
        "planner_version"
      ],
      "properties": {
        "dataset_version": {"const": "2026-08-24", "format": "date"},
        "metric_registry_version": {"const": "1.0.0"},
        "state_rule_version": {"const": "1.2.0"},
        "quality_rule_version": {"const": "1.1.0"},
        "rating_rule_version": {"const": "1.0.0"},
        "answer_policy_version": {"const": "1.0.0"},
        "planner_version": {"const": "1.0.0"}
      }
    },
    "artifactFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "size_bytes",
        "sha256",
        "report_id",
        "logical_hash"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "kind": {"enum": ["parquet", "report", "duckdb"]},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "report_id": {
          "type": ["string", "null"]
        },
        "logical_hash": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "report"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "report_id": {"enum": ["source_audit", "quality_summary"]},
              "logical_hash": {"$ref": "#/$defs/sha256"}
            }
          },
          "else": {
            "properties": {
              "report_id": {"type": "null"},
              "logical_hash": {"type": "null"}
            }
          }
        }
      ]
    },
    "artifactTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_name",
        "layer",
        "grain",
        "parquet_path",
        "row_count",
        "schema_sha256",
        "sort_key",
        "unique_key",
        "logical_hash"
      ],
      "properties": {
        "table_name": {"type": "string", "minLength": 1},
        "layer": {"enum": ["bronze", "silver", "gold"]},
        "grain": {"type": "string", "minLength": 1},
        "parquet_path": {"$ref": "#/$defs/safePath"},
        "row_count": {"type": "integer", "minimum": 0},
        "schema_sha256": {"$ref": "#/$defs/sha256"},
        "sort_key": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "unique_key": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "logical_hash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
