{
  "type": "object",
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "lookup",
        "screen",
        "screen_rank",
        "compare",
        "aggregate",
        "explain",
        "clarify",
        "unsupported"
      ]
    },
    "product_types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "enum": [
          "domestic_bond",
          "domestic_etf",
          "domestic_etn",
          "overseas_etf",
          "overseas_etn",
          "public_fund"
        ]
      }
    },
    "entities": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "identifier_type": {
            "type": "string",
            "enum": [
              "unknown",
              "product_id",
              "market_identifier",
              "isin",
              "ticker",
              "name"
            ]
          }
        },
        "required": [
          "text",
          "identifier_type"
        ]
      }
    },
    "as_of_date": {
      "type": "string",
      "format": "date"
    },
    "result_grain": {
      "type": "string",
      "enum": [
        "product",
        "instrument",
        "listed_product",
        "fund_item",
        "fund_attribute",
        "fund_family_candidate"
      ]
    },
    "filters": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "operator": {
            "type": "string",
            "enum": [
              "eq",
              "ne",
              "gt",
              "gte",
              "lt",
              "lte",
              "in",
              "not_in",
              "between",
              "contains",
              "starts_with",
              "is_missing",
              "is_not_missing"
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                }
              }
            ]
          }
        },
        "required": [
          "field",
          "operator",
          "value"
        ]
      }
    },
    "metrics": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string"
      }
    },
    "sort": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          }
        },
        "required": [
          "field",
          "direction"
        ]
      }
    },
    "aggregation": {
      "type": "object",
      "properties": {
        "function": {
          "type": "string",
          "enum": [
            "none",
            "count",
            "min",
            "max",
            "sum",
            "avg"
          ]
        },
        "field": {
          "type": "string"
        },
        "group_by": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "function",
        "field",
        "group_by"
      ]
    },
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "top_k_scope": {
      "type": "string",
      "enum": [
        "global",
        "per_product_type"
      ]
    },
    "needs_clarification": {
      "type": "boolean"
    },
    "clarification_reason": {
      "type": "string"
    }
  },
  "required": [
    "intent",
    "product_types",
    "entities",
    "as_of_date",
    "result_grain",
    "filters",
    "metrics",
    "sort",
    "aggregation",
    "top_k",
    "top_k_scope",
    "needs_clarification",
    "clarification_reason"
  ]
}
